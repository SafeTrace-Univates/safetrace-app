<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <!-- Botão Voltar -->
    <ImageView
        android:id="@+id/imageViewVoltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="347dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/mapContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_arrow_back_24"
        app:tint="@color/primaria" />

    <!-- Mapa - será carregado programaticamente -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@+id/scrollViewDados"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewVoltar" />

    <!-- ScrollView com dados -->
    <ScrollView
        android:id="@+id/scrollViewDados"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:maxHeight="250dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonPlayAudio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mapContainer">

        <TextView
            android:id="@+id/textViewDados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:fontFamily="@font/poppins"
            android:lineSpacingExtra="4dp"
            android:text="Dados do trajeto"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </ScrollView>

    <!-- Botão Reproduzir Áudio -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonPlayAudio"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/primaria"
        android:fontFamily="@font/poppins_semibold"
        android:text="Reproduzir Áudio"
        android:textColor="@color/fundo"
        android:textSize="16sp"
        app:cornerRadius="6dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonCompartilharAudio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollViewDados" />

    <!-- Botão Compartilhar Áudio -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonCompartilharAudio"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primaria"
        android:fontFamily="@font/poppins_semibold"
        android:text="Compartilhar Áudio"
        android:textColor="@color/fundo"
        android:textSize="16sp"
        app:cornerRadius="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonPlayAudio" />

</androidx.constraintlayout.widget.ConstraintLayout>
