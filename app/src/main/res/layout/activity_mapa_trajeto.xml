<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollViewTrajeto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="30dp">

        <!-- ====== Cabeçalho com voltar, título e menu ====== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp"
            android:paddingHorizontal="8dp">

            <!-- Ícone voltar -->
            <ImageButton
                android:id="@+id/buttonVoltar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/baseline_arrow_back_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Título -->
            <TextView
                android:id="@+id/textTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SafeTrace"
                android:textColor="@color/primaria"
                android:textSize="24sp"
                android:fontFamily="@font/poppins_semibold"
                app:layout_constraintStart_toEndOf="@id/buttonVoltar"
                app:layout_constraintEnd_toStartOf="@id/buttonMenu"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.5" />

            <!-- Ícone menu -->
            <ImageButton
                android:id="@+id/buttonMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/baseline_dehaze_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/textTrajetoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trajeto da Emergência"
            android:textColor="@color/primaria"
            android:textSize="22sp"
            android:fontFamily="@font/poppins"
            app:layout_constraintStart_toEndOf="@id/buttonVoltar"
            app:layout_constraintEnd_toStartOf="@id/buttonMenu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            android:layout_marginTop="20dp"/>

        <!-- Data e duração -->
        <TextView
            android:id="@+id/textDataDuracao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="21/10/2025  •  12 minutos"
            android:textColor="@color/primaria"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- Mapa (simulado como imagem) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:layout_marginBottom="20dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/rounded_map_background"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/mapaTrajeto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/mapa_exemplo" />
        </FrameLayout>


        <!-- Ponto de Início -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_card_contato"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="#90C695"
                android:src="@drawable/baseline_location_on_24"
                android:background="@drawable/bg_botao_redondo_verde"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:text="Ponto de Início"
                    android:textColor="@color/cinza"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="14:35 - Chamada iniciada"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Lat: -23.5505, Lng: -46.6333"
                    android:textColor="@color/cinza"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Ponto de Fim -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/bg_card_contato"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/baseline_location_on_24"
                android:background="@drawable/bg_botao_redondo_salmao"
                android:padding="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:text="Ponto de Fim"
                    android:textColor="@color/cinza"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="14:47 - Chamada finalizada"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>

                <TextView
                    android:text="Lat: -23.5629, Lng: -46.6544"
                    android:textColor="@color/cinza"
                    android:textSize="14sp"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Resumo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="6dp"
            android:backgroundTintMode="src_over"
            android:elevation="2dp"
            android:clipToOutline="true"
            android:background="@drawable/bg_resumo_chamada">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/baseline_watch_later_24"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="Resumo da Chamada"
                    android:textColor="@color/primaria"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:text="Acionado por: Ana Oliveira"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_marginBottom="2dp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content" />

            <TextView
                android:text="Contatos notificados: Maria Silva, João Santos"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
